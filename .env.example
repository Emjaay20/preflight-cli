DATABASE_URL=postgresql://preflight:preflight@localhost:5432/preflight
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
LOG_LEVEL=info
DATA_DIR=./data
FIXTURES_DIR=./fixtures/harbor-node
PREFLIGHT_BIN=./target/debug/preflight
DEMO_MODE=true
DEMO_API_KEY=pf_live_demo_harbor_localdevsecret0001
# Required only when API and worker use remote CAS transport. Keep this secret
# private and use the same value in both services.
INTERNAL_BLOB_TOKEN=replace-with-a-long-random-cluster-secret
# Optional: report blocked, needs-human, and failed reviews to a Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Browser sign-in uses WorkOS Staging until you deliberately configure a
# production environment. Do not put browser credentials in the client.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3080/v1/auth/workos/callback
WORKOS_COOKIE_SECRET=replace-with-a-long-random-cookie-secret
# Used when generating one-time member invitation links.
PUBLIC_APP_URL=http://localhost:3080
# Comma-separated platform-owner addresses allowed to use /operator. This is
# separate from per-workspace admin access and requires WorkOS browser sign-in.
PLATFORM_OPERATOR_EMAILS=
