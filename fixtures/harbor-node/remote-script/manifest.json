{
  "manifest_version": 3,
  "name": "Harbor Node",
  "version": "1.2.2",
  "description": "Relay unused bandwidth.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://relay.harbor.example/*",
    "http://relay.harbor.example/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon.png"
  }
}
