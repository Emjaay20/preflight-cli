generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  accountType String     @default("organization")
  createdAt   DateTime   @default(now())
  plan        String     @default("free_evaluation")
  reviewLimit Int        @default(10)
  projectLimit Int       @default(2)
  artifactLimitBytes Int @default(26214400)
  retentionDays Int      @default(14)
  projects    Project[]
  apiKeys     ApiKey[]
  workosIdentities WorkosIdentity[]
  auditEvents AuditEvent[]
  accessRequests AccessRequest[]
}

model ApiKey {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  role           String         @default("admin")
  prefix         String         @unique
  hash           String
  createdAt      DateTime       @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  replacedById   String?
  workosIdentities WorkosIdentity[]
}

// A browser identity is deliberately separate from an API key.  The API key
// remains the credential for local/CI use, while a WorkOS account can receive
// the same workspace role through an encrypted browser session.
model WorkosIdentity {
  id            String       @id @default(cuid())
  workosUserId  String       @unique
  email         String
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeyId      String       @unique
  apiKey        ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([organizationId, email])
}

model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor String
  action String
  targetType String
  targetId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

model AccessRequest {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email String
  message String?
  status String @default("open")
  createdAt DateTime @default(now())
  @@index([organizationId, status])
}


model Project {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  slug           String
  defaultClaims  Json?
  createdAt      DateTime       @default(now())
  reviews        Review[]
  @@unique([organizationId, slug])
}

enum ReviewStatus {
  queued
  running
  completed
  failed
}

model Review {
  id              String         @id
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  status          ReviewStatus
  verdict         String?
  artifactName    String
  artifactSha256  String
  artifactPath    String
  claims          Json?
  packs           String[]
  submittedBy     String?
  inventory       Json?
  report          Json?
  markdown        String?
  error           String?
  createdAt       DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  signedOffAt     DateTime?
  signedOffBy     String?
  signOffDecision String?
  signOffNotes    String?
  findings        Finding[]
  outbox          OutboxEvent[]
}


model Finding {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  findingKey String
  controlId  String
  pack       String
  severity   String
  file       String
  field      String
  line       Int
  snippet    String
  title      String
  summary    String
}

model OutboxEvent {
  id          String    @id @default(cuid())
  reviewId    String?
  review      Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  slackPublishedAt DateTime?
}
