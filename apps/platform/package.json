{
  "name": "@preflight/platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:worker": "tsx watch src/worker.ts",
    "start:worker:prod": "node dist/worker.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.1.0",
    "@preflight/domain": "0.2.0",
    "@preflight/scanner": "0.2.0",
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.44.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "multer": "^1.4.5-lts.1",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
