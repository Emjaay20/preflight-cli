FROM rust:1.75-slim AS rust
WORKDIR /src
COPY Cargo.toml ./
COPY src ./src
RUN cargo build --release

FROM node:22-bookworm-slim AS node
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY packages ./packages
COPY apps/platform ./apps/platform
RUN npm install
RUN npm run build -w @preflight/domain && npm run build -w @preflight/scanner
WORKDIR /app/apps/platform
RUN npx prisma generate && npx tsc -p tsconfig.json

FROM node:22-bookworm-slim AS api
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates zip unzip openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=node /app /app
COPY --from=rust /src/target/release/preflight /usr/local/bin/preflight
COPY fixtures ./fixtures
ENV NODE_ENV=production
ENV PREFLIGHT_BIN=/usr/local/bin/preflight
WORKDIR /app/apps/platform
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]

FROM node:22-bookworm-slim AS worker
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates zip unzip openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=node /app /app
COPY --from=rust /src/target/release/preflight /usr/local/bin/preflight
COPY fixtures ./fixtures
ENV NODE_ENV=production
ENV PREFLIGHT_BIN=/usr/local/bin/preflight
WORKDIR /app/apps/platform
CMD ["node", "dist/worker.js"]
